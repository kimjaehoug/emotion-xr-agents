# 데이터베이스
DATABASE_URL=sqlite:///./data/state_agent.db

# 앱 설정
APP_NAME=State-Aware AI Agent PoC
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Baseline 정책
MIN_BASELINE_SAMPLES=3
USE_GROUP_DEFAULT_BASELINE=false
BASELINE_TRIM_RATIO=0.1
BASELINE_UPDATE_MAX_DRIFT=0.25

# 상태 분류 임계값
WATCH_DEVIATION_THRESHOLD=0.15
ACTION_DEVIATION_THRESHOLD=0.30
PERSISTENCE_THRESHOLD=2
MIN_CONFIDENCE=0.6
MIN_COMPLETENESS=0.7
RECENT_EPISODE_WINDOW=5

# Ollama / Qwen3.5 9B (16GB RAM 기준 컨텍스트 4096)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_NUM_CTX=4096
OLLAMA_ENABLED=true
OLLAMA_TIMEOUT_SEC=60
