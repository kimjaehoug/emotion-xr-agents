# 배포/8080 서버(llama.cpp 등) 기준 기본값 예시.
# 로컬에서 8080이 떠 있지 않다면 .env 파일에서 Ollama(11434) 설정을 사용하세요.

DEBUG=true
DATABASE_URL=sqlite:///./data/xr_agent.db

LOCAL_LLM_BASE_URL=http://localhost:8080/v1
LOCAL_LLM_MODEL=qwen3.5-9b
LOCAL_LLM_API_KEY=local
LOCAL_LLM_TIMEOUT_SEC=60
LOCAL_LLM_MAX_RETRIES=2
LOCAL_LLM_TEMPERATURE=0.1
LOCAL_LLM_MAX_TOKENS=1200
LOCAL_LLM_JSON_SCHEMA_ENABLED=true

LLM_REPAIR_MAX_ATTEMPTS=1
LLM_STORE_SANITIZED_PROMPTS=false

XR_MAX_PARAMETER_DELTA=0.20
XR_AUTO_CONTROL_MIN_CONFIDENCE=0.80
XR_OBSERVATION_MIN_CONFIDENCE=0.60

CONTENT_CANDIDATE_LIMIT=10
CONTENT_RECOMMENDATION_TOP_K=5
